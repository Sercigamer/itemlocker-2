{
	"schemaVersion": 1,
	"id": "itemlocker",
	"version": "${version}",
	"name": "ItemLocker",
	"description": "Sperrt Hotbar-Slots und Item-Typen: gesperrte Items fallen erst, wenn man die Drop-Taste mehrfach hintereinander drueckt.",
	"authors": [
		"${github_user}"
	],
	"contact": {
		"homepage": "https://github.com/${github_user}/${github_repo}",
		"sources": "https://github.com/${github_user}/${github_repo}",
		"issues": "https://github.com/${github_user}/${github_repo}/issues"
	},
	"license": "MIT",
	"icon": "assets/itemlocker/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.itemlocker.client.ItemLockerClient"
		],
		"modmenu": [
			"com.itemlocker.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "itemlocker.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
